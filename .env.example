# Who you are, recorded in every artifact you produce (census.py). Use your initials,
# the same ones as the Accept/Notes columns of the table (e.g. RG, GS).
CENSUS_OPERATOR=

# LLM backend for the legacy main.py analyze/narrative steps: claude (default) or gemini
#   claude — Claude Code CLI in headless mode (`claude -p`), uses the Claude
#            subscription you are logged into; no API key needed
#   gemini — Google GenAI API, needs GEMINI_API_KEY below
# (census.py takes the backend of each agent from census.toml instead.)
LLM_BACKEND=claude

# Gemini API key — only for LLM_BACKEND=gemini / gemini agents. Get one from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
